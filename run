#!/usr/bin/env bash
#
# run — start the whole Fake News Detective stack:
#         * the local analysis API   (FastAPI, port 8000)
#         * the landing page         (static docs/, port 8080)
#
#       First run creates backend/.venv and installs dependencies.
#       Ctrl+C stops both servers.
#
#       Override ports:  API_PORT=9000 WEB_PORT=9090 run
#
set -u

ROOT="$(cd "$(dirname "$0")" && pwd)"
BACKEND="$ROOT/backend"
DOCS="$ROOT/docs"
VENV="$BACKEND/.venv"
PY="$VENV/bin/python"
REQ="$BACKEND/requirements.txt"
STAMP="$VENV/.requirements.sha256"
LOGS="$ROOT/.run-logs"

API_PORT="${API_PORT:-8000}"
WEB_PORT="${WEB_PORT:-8080}"

if [ -t 1 ]; then
  B=$'\033[1m'; D=$'\033[2m'; G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; C=$'\033[36m'; O=$'\033[0m'
else
  B=''; D=''; G=''; Y=''; R=''; C=''; O=''
fi

step() { printf '%s==>%s %s\n' "${G}${B}" "$O" "$*"; }
warn() { printf '%s  ! %s%s\n' "$Y" "$*" "$O"; }
die()  { printf '%s  x %s%s\n' "$R" "$*" "$O" >&2; exit 1; }

port_busy() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

free_port() { # $1 = port, $2 = label
  port_busy "$1" || return 0
  warn "port $1 ($2) is already in use — stopping the process holding it"
  pids="$(lsof -nP -tiTCP:"$1" -sTCP:LISTEN 2>/dev/null)"
  [ -n "$pids" ] && kill $pids 2>/dev/null
  i=0
  while [ $i -lt 20 ]; do
    port_busy "$1" || return 0
    sleep 0.25
    i=$((i + 1))
  done
  die "could not free port $1 — close it manually, or start with: ${2}_PORT=<other> run"
}

# ---------------------------------------------------------------- preflight --
[ -f "$REQ" ]        || die "no backend/requirements.txt under $ROOT — is this the right folder?"
[ -f "$DOCS/index.html" ] || die "no docs/index.html to serve as the landing page"
command -v python3 >/dev/null 2>&1 || die "python3 not found on PATH"

need_install=0
if [ ! -x "$PY" ]; then
  step "first run — creating virtualenv at backend/.venv"
  python3 -m venv "$VENV" || die "could not create the virtualenv"
  need_install=1
fi

req_hash="$(shasum -a 256 "$REQ" | awk '{print $1}')"
if [ ! -f "$STAMP" ] || [ "$(cat "$STAMP" 2>/dev/null)" != "$req_hash" ]; then
  need_install=1
fi

if [ "$need_install" -eq 1 ]; then
  step "installing backend dependencies (this only happens when requirements.txt changes)"
  "$PY" -m pip install --quiet --upgrade pip || die "pip upgrade failed"
  "$PY" -m pip install --quiet -r "$REQ"     || die "dependency install failed — see the error above"
  printf '%s\n' "$req_hash" > "$STAMP"
fi

mkdir -p "$LOGS"
free_port "$API_PORT" API
free_port "$WEB_PORT" WEB

# ------------------------------------------------------------------ cleanup --
API_PID=""
WEB_PID=""
cleanup() {
  trap - INT TERM EXIT
  printf '\n'
  step "shutting down"
  [ -n "$API_PID" ] && kill "$API_PID" 2>/dev/null
  [ -n "$WEB_PID" ] && kill "$WEB_PID" 2>/dev/null
  wait 2>/dev/null
  # belt and braces: nothing of ours may keep holding the ports
  for p in "$API_PORT" "$WEB_PORT"; do
    leftover="$(lsof -nP -tiTCP:"$p" -sTCP:LISTEN 2>/dev/null)"
    [ -n "$leftover" ] && kill $leftover 2>/dev/null
  done
  exit 0
}
trap cleanup INT TERM EXIT

# ------------------------------------------------------------------- launch --
step "starting analysis API      ${D}(logs: .run-logs/api.log)${O}"
( cd "$BACKEND" && exec "$PY" -m uvicorn main:app --port "$API_PORT" ) > "$LOGS/api.log" 2>&1 &
API_PID=$!

step "starting landing page      ${D}(logs: .run-logs/web.log)${O}"
( cd "$DOCS" && exec "$PY" -m http.server "$WEB_PORT" --bind 127.0.0.1 ) > "$LOGS/web.log" 2>&1 &
WEB_PID=$!

# wait for the API to answer /health
health=""
i=0
while [ $i -lt 60 ]; do
  kill -0 "$API_PID" 2>/dev/null || break
  health="$(curl -fsS "http://127.0.0.1:$API_PORT/health" 2>/dev/null)"
  [ -n "$health" ] && break
  sleep 0.5
  i=$((i + 1))
done

if [ -z "$health" ]; then
  printf '\n%s--- backend/.run-logs/api.log -------------------------------%s\n' "$D" "$O"
  tail -25 "$LOGS/api.log"
  die "the analysis API failed to start"
fi

case "$health" in
  *'"model_is_stub":false'*) model_line="${G}real trained model loaded${O}" ;;
  *)                         model_line="${Y}STUB model — no artifacts in backend/artifacts/${O}" ;;
esac

# ------------------------------------------------------------------- banner --
printf '\n'
printf '  %sFake News Detective is running%s\n' "$B" "$O"
printf '  %s──────────────────────────────────────────────%s\n' "$D" "$O"
printf '  Landing page   %s%shttp://localhost:%s%s\n' "$C" "$B" "$WEB_PORT" "$O"
printf '  Analysis API   %shttp://localhost:%s%s   %s(POST /analyze)%s\n' "$C" "$API_PORT" "$O" "$D" "$O"
printf '  Model          %s\n' "$model_line"
printf '  %s──────────────────────────────────────────────%s\n' "$D" "$O"
printf '  %sExtension:%s chrome://extensions → Developer mode → Load unpacked → %s%s/extension%s\n' "$B" "$O" "$D" "$ROOT" "$O"
printf '  %sPress Ctrl+C to stop both servers.%s\n\n' "$D" "$O"

wait
